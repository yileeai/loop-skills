filters:
  and:
    - file.hasTag("garden")
    - '!file.inFolder("90-System 系统/模板中心")'
formulas:
  花园: if(file.hasTag("garden/plant"), "🌱 播种", if(file.hasTag("garden/cultivate"), "☘️ 培育", if(file.hasTag("garden/question"), "🍄 待回答", if(file.hasTag("garden/repot"), "🪴 移栽", if(file.hasTag("garden/revisit"), "🍁 重访", "🌿")))))
views:
  - type: table
    name: 知识花园
    groupBy:
      property: formula.花园
      direction: ASC
    order:
      - file.name
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
