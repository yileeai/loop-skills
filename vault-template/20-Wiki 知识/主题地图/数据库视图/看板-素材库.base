filters:
  and:
    - file.inFolder("10-Raw 原料")
    - '!file.name.startsWith("_")'
formulas:
  分类: file.folder.split("/")[-1]
views:
  - type: table
    name: 待编译
    filters:
      and:
        - '!file.inFolder("10-Raw 原料/09-已归档")'
    groupBy:
      property: formula.分类
      direction: ASC
    order:
      - file.name
      - file.ext
      - file.size
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 已归档
    filters:
      and:
        - file.inFolder("10-Raw 原料/09-已归档")
    order:
      - file.name
      - file.ext
      - file.backlinks
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
